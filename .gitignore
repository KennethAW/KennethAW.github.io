# Local editor and tooling state
.claude/*
.vscode/
.idea/

# ...but the agent definition and the dev-server config are project
# infrastructure, not local state: tools/ is tracked, so the agent that drives
# tools/audit.py has to be too, or a fresh clone loses it.
!.claude/agents/
!.claude/launch.json

# Build output and dependencies
node_modules/
dist/
dist-ssr/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Logs and temp files
*.log
*.tmp
_verify_out/
